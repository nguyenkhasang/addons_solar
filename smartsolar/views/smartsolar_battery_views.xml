<odoo>
    <record id="battery_list" model="ir.ui.view"><field name="name">smartsolar.battery.list</field><field name="model">smartsolar.battery</field><field name="arch" type="xml"><list><field name="name"/><field name="system_id"/><field name="device_identifier"/><field name="bms_model"/><field name="firmware"/><field name="last_seen"/></list></field></record>
    <record id="battery_form" model="ir.ui.view"><field name="name">smartsolar.battery.form</field><field name="model">smartsolar.battery</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/><field name="system_id"/><field name="device_identifier"/><field name="bms_model"/><field name="hardware"/><field name="firmware"/><field name="last_seen"/></group><group string="Nhịp lấy mẫu và ngưỡng"><field name="history_enabled"/><field name="history_interval" invisible="not history_enabled"/><field name="retention_days"/><field name="stale_seconds"/><field name="offline_seconds"/><field name="current_deadband"/><field name="cell_delta_warning"/></group><field name="telemetry_ids" readonly="1"><list><field name="record_date"/><field name="soc"/><field name="voltage"/><field name="current"/><field name="power"/><field name="cell_delta_voltage"/><field name="temperature"/></list></field></sheet></form></field></record>
    <record id="battery_action" model="ir.actions.act_window"><field name="name">Pin JK BMS</field><field name="res_model">smartsolar.battery</field><field name="view_mode">list,form</field></record>
    <menuitem id="battery_menu" name="Pin JK BMS" action="battery_action" parent="menu_smartsolar_root" sequence="25"/>
    <record id="ir_cron_purge_battery" model="ir.cron"><field name="name">SmartSolar: dọn lịch sử BMS</field><field name="model_id" ref="model_smartsolar_battery"/><field name="state">code</field><field name="code">model._cron_purge_history()</field><field name="interval_number">1</field><field name="interval_type">days</field></record>
</odoo>
