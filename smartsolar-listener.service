[Unit]
Description=SmartSolar continuous MQSolar WebSocket listener
After=smartsolar-odoo.service network-online.target

[Service]
Type=simple
WorkingDirectory=%h/odoo-19.0
ExecStart=/bin/bash %h/addons_solar/smartsolar-listener.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
