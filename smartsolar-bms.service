[Unit]
Description=SmartSolar read-only JK BMS BLE collector
After=smartsolar-odoo.service bluetooth.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/odoo-19.0
ExecStart=/bin/bash %h/addons_solar/smartsolar-bms.sh run
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
KillMode=mixed
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=default.target
