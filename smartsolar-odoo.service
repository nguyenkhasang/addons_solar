[Unit]
Description=SmartSolar Odoo 19
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/odoo-19.0
ExecStart=%h/addons_solar/odoo-service.sh run
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=mixed
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
